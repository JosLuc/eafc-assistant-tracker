# Copie para .env.local e preencha. Nunca commite o .env.local (o .gitignore já ignora .env*).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Auxiliar (IA). Chaves gratuitas:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Opcional: força modelos específicos (lista separada por vírgula). Sem isso, a rota escolhe o mais novo disponível.
# GEMINI_MODEL=
# GROQ_MODEL=
# GROQ_VISION_MODEL=

# Opcional: pasta com os saves reais usados pelos testes (padrão: ./saves).
# FC27_SAVES_DIR=
